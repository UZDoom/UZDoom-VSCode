                },
                {
                    "when": "false",
                    "command": "pk3fs.unmountPk3File"
                },
                {
                    "when": "false",
                    "command": "wad.mountWadFile"
                },
                {
                    "when": "false",
                    "command": "wad.unmountWadFile"
                },
                {
                    "when": "editorLangId == pk3",
                    "command": "pk3fs.mountPk3Editor"
                },
                {
                    "when": "editorLangId == wad",
                    "command": "wad.mountWadEditor"
                }
            ]
