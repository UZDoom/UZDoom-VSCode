        "customEditors": [
            {
                "viewType": "uzdoom.doomLump.previewEditor",
                "displayName": "WAD Lump Viewer",
                "selector": [
                    {
                        "filenamePattern": "*.lmp"
                    },
                    {
                        "filenamePattern": "*.snd"
                    }
                ],
                "priority": "default"
            }
        ],
