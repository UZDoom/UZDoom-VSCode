{
    "name": "uzdoom-vscode",
    "displayName": "UZDoom ZScript",
    "description": "UZDoom's multiple scripting languages support (with a focus on ZScript) for VSCode (and compatible editors)",
    "publisher": "UZDoom",
    "icon": "icons/UZDoom.png",
    "version": "2.0.0",
    "scripts": {
        "compile": "tsc -p ./",
        "lint": "eslint src --ext ts",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "esbuild-base": "node post-build.js && esbuild ./src/extension.ts --bundle --tsconfig=./tsconfig.json --external:vscode --format=cjs --platform=node --outfile=dist/extension.js",
        "watch": "npm run -S esbuild-base -- --sourcemap --sources-content=false --watch",
        "esbuild-web": "esbuild ./src/web-extension.ts --bundle --tsconfig=./tsconfig.json --external:vscode --format=cjs --platform=browser --outfile=dist/web-extension.js",
        "watch-web": "npm run -S esbuild-web -- --sourcemap --sources-content=false --watch",
        "build": "npm run -S esbuild-base -- --sourcemap --sources-content=false && npm run -S esbuild-web -- --sourcemap --sources-content=false",
        "package": "vsce package",
        "publish": "vsce publish",
        "publish-pre-release": "vsce publish --pre-release",
        "vscode:prepublish": "rimraf dist && npm run -S esbuild-base -- --minify && npm run -S esbuild-web -- --minify",
        "test": "npm run typecheck"
    },
    "devDependencies": {
        "@types/chalk": "^2.2.0",
        "@types/glob": "^7.2.0",
        "@types/lodash.get": "^4.4.9",
        "@types/mocha": "^9.1.1",
        "@types/node": "^14.14.37",
        "@types/split2": "^4.2.1",
        "@types/vscode": "^1.120.0",
        "@typescript-eslint/eslint-plugin": "^5.17.0",
        "@typescript-eslint/parser": "^5.17.0",
        "@vscode/debugadapter": "^1.56.0",
        "@vscode/debugadapter-testsupport": "^1.56.0",
        "await-notify": "^1.0.1",
        "base64-js": "^1.5.1",
        "chai": "^6.2.2",
        "esbuild": "^0.14.29",
        "eslint": "^8.12.0",
        "events": "^3.3.0",
        "glob": "^7.2.0",
        "mocha": "^9.2.2",
        "path-browserify": "^1.0.1",
        "rimraf": "^3.0.2",
        "typescript": "^4.6.3",
        "url": "^0.11.0",
        "vsce": "^2.7.0",
        "wait-port": "^1.1.0"
    },
    "dependencies": {
        "@johnlindquist/node-window-manager": "^1.0.24",
        "@lunapaint/png-codec": "^0.2.0",
        "@yarnpkg/fslib": "^3.1.2",
        "@yarnpkg/libzip": "^3.1.1",
        "chalk": "^5.3.0",
        "find-process": "^1.4.10",
        "list-open-files": "^1.1.0",
        "lodash.get": "^4.4.2",
        "pino": "^8.15.1",
        "pino-pretty": "^10.2.0",
        "split2": "^4.2.0",
        "tokenizr": "^1.0.0",
        "vscode-languageclient": "^5.2.1",
        "vscode-uri": "^3.1.0"
    },
    "main": "./dist/extension.js",
    "browser": "./dist/web-extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/UZDoom/UZDoom-VSCode.git"
    },
    "engines": {
        "vscode": "^1.52.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "workspaceContains:**/*.pk3",
        "workspaceContains:**/*.wad",
        "workspaceContains:**/*.iwad",
        "workspaceContains:**/*.ipk3",
        "workspaceContains:**/*.ipk7",
        "onLanguage:pk3",
        "onFileSystem:pk3",
        "onLanguage:wad",
        "onFileSystem:wad",
        "onDebugResolve:uzdoom",
        "onDebugDynamicConfigurations:uzdoom",
        "onLanguage:zscript",
        "onLanguage:acs",
        "onLanguage:decorate",
        "onLanguage:dehacked",
        "onStartupFinished"
    ],
