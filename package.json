                    "command": "pk3fs.mountPk3File",
                    "group": "navigation"
                },
                {
                    "when": "resourceLangId == pk3 && explorerResourceIsRoot",
                    "command": "pk3fs.unmountPk3File",
                    "group": "navigation"
                },
                {
                    "when": "resourceLangId == wad && !explorerResourceIsRoot",
                    "command": "wad.mountWadFile",
                    "group": "navigation"
                },
